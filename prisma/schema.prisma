generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationKind {
  SYSTEM
  USER
}

enum Chain {
  ETHEREUM
  SOLANA
}

enum OwnershipStatus {
  CURATED
  UNCLAIMED
  CLAIMED
}

enum ScanStatus {
  QUEUED
  RUNNING
  PARTIAL_COMPLETE
  COMPLETE
  FAILED
  EXPIRED
}

enum ScanAttemptStatus {
  ACCEPTED
  RATE_LIMITED
  INVALID
  ERROR
  DUPLICATE
}

enum ModuleName {
  GOVERNANCE
  ORACLE
  SIGNER
  FRONTEND
}

enum ModuleStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
  SKIPPED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum Grade {
  A
  B
  C
  D
  F
}

enum ClaimMethod {
  SIGN_MESSAGE
  ENS
  DNS_TXT
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubscriptionTier {
  FREE
  PAID
}

enum GovernorType {
  OZ_GOVERNOR
  COMPOUND_BRAVO
  CUSTOM
}

enum ProxyType {
  EIP_1967_TRANSPARENT
  EIP_1822_UUPS
  CUSTOM
  NONE
}

enum VotingSnapshotType {
  BLOCK_BASED
  CURRENT_BALANCE
  NONE
}

enum ContractRole {
  PRIMARY
  PROXY_IMPLEMENTATION
  DECLARED_MULTISIG
  DECLARED_BRIDGE
  TOKEN_CONTRACT
  TIMELOCK
  RELATED
}

model Organization {
  id            String           @id @default(cuid())
  name          String
  kind          OrganizationKind
  users         User[]
  protocols     Protocol[]
  claims        ProtocolClaim[]
  subscriptions Subscription[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  emailVerified  DateTime? // EXACT field name required by @auth/prisma-adapter; DO NOT RENAME
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  scans          Scan[]
  scanAttempts   ScanAttempt[]
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Protocol {
  id                     String          @id @default(cuid())
  slug                   String          @unique
  displayName            String
  chain                  Chain
  primaryContractAddress String
  /// @deprecated Plan 03 §3.4: superseded by the new Contract model. New
  /// scans no longer write this column — related-contract data lives on
  /// per-scan Contract rows. The column is kept on the schema for backward-
  /// compat reads of pre-Plan-03 Protocol rows but is dead data going
  /// forward. Plan 05+ may consider dropping it after a sufficient grace
  /// period and a separate destructive-migration plan.
  extraContractAddresses Json            @default("[]")
  domain                 String?
  logoUrl                String?
  ownershipStatus        OwnershipStatus
  organizationId         String?
  organization           Organization?   @relation(fields: [organizationId], references: [id])
  /// @deprecated Plan 02 legacy shape. Prefer submitting multisigs as structured `relatedContracts[]` entries with role `DECLARED_MULTISIG` (Plan 03 §4.2). Phase E retains a PRIMARY-only fallback that reads `knownMultisigs[0]` only when no sibling `DECLARED_MULTISIG` Contract row exists for the scan — see `loadContractContext` in `execute-governance-module.ts`. Remove field when all clients migrate.
  knownMultisigs         Json            @default("[]")
  expectedRiskProfile    Grade? // internal calibration target — never publish as observed grade
  latestDemoScanId       String?
  latestDemoScan         Scan?           @relation("ProtocolLatestDemoScan", fields: [latestDemoScanId], references: [id])
  scans                  Scan[]          @relation("ProtocolScans")
  claims                 ProtocolClaim[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([chain, primaryContractAddress])
}

model ProtocolClaim {
  id             String       @id @default(cuid())
  protocolId     String
  protocol       Protocol     @relation(fields: [protocolId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  proofMethod    ClaimMethod
  proofData      Json
  status         ClaimStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Scan {
  id                    String              @id @default(uuid())
  protocolId            String
  protocol              Protocol            @relation("ProtocolScans", fields: [protocolId], references: [id])
  latestDemoForProtocol Protocol[]          @relation("ProtocolLatestDemoScan")
  submittedByUserId     String?
  submittedByUser       User?               @relation(fields: [submittedByUserId], references: [id])
  submittedEmail        String?
  submittedEmailHash    String?
  ipHash                String
  userAgent             String
  status                ScanStatus          @default(QUEUED)
  // Plan 03 §3.3: protocol-composite fields restructured.
  // `compositeGrade` widens to "worst contributing contract's grade" (§6.2).
  compositeGrade        Grade?
  // Plan 03 §3.5: renamed from `compositeScore`. Holds the arithmetic mean
  // of per-Contract scores across graded Contracts (spec §6.2).
  averageContractScore  Int?
  // Plan 03 §6.2: lowest `Contract.compositeScore` among Contracts whose
  // grade matches `Scan.compositeGrade` (ties broken by lowest score).
  worstContractScore    Int?
  // Plan 02 I.1 FIX 3 semantic carryover — detector-error degradation clause.
  // Aggregates across all Contracts in the scan in Plan 03 (§6.3).
  isPartialGrade        Boolean             @default(false)
  // Plan 03 §6.3 extension — graph-coverage clause. True when ≥1 graded
  // Contract coexists with ≥1 FAILED Contract. Implementation choice per
  // Plan 03 plan §20: two booleans rather than a partialReasons enum array.
  isPartialCoverage     Boolean             @default(false)
  expiresAt             DateTime
  createdAt             DateTime            @default(now())
  completedAt           DateTime?
  modules               ModuleRun[]
  contracts             Contract[]
  findings              Finding[]
  scanAttempts          ScanAttempt[]
  // Plan 03 §3.5 PR 1: was `GovernanceSnapshot?` in Plan 02 (1:1 via
  // GovernanceSnapshot.scanId @unique). PR 1 drops the @unique on
  // scanId so this side widens to an array. In practice every historical
  // row still has at most one snapshot per scan (data invariant from
  // Plan 02's now-removed constraint); going forward, snapshots key on
  // contractId via the Contract.governanceSnapshot relation.
  governanceSnapshot    GovernanceSnapshot[]

  // Dispatcher tracking (Plan 02 B.2 + C.4)
  dispatchedAt       DateTime?
  executionStartedAt DateTime?
  inngestEventId     String?

  @@index([submittedEmail])
  @@index([expiresAt])
}

model ScanAttempt {
  id               String            @id @default(cuid())
  ipHash           String
  userId           String?
  user             User?             @relation(fields: [userId], references: [id])
  attemptedAt      DateTime          @default(now())
  status           ScanAttemptStatus
  reason           String?
  userAgent        String
  inputPayloadHash String
  cooldownKey      String // always ${chain}:${normalizedAddress} — NEVER Protocol.id; Phase D uses pg_advisory_xact_lock(hashtext(cooldownKey)) for atomic cooldown
  scanId           String?
  scan             Scan?             @relation(fields: [scanId], references: [id])

  @@index([ipHash, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([inputPayloadHash, ipHash, attemptedAt])
  @@index([cooldownKey, attemptedAt])
}

model ModuleRun {
  id               String       @id @default(cuid())
  scanId           String
  scan             Scan         @relation(fields: [scanId], references: [id])
  // Plan 03 §3.5 PR 2: tightened to NOT NULL (was nullable in PR 1) now
  // that the backfill has populated contractId on every row. The legacy
  // @@unique([scanId, module]) was dropped in PR 1's
  // `plan_03_drop_modulerun_legacy_unique` migration so the multi-Contract
  // execution model (§4.2's N×M ModuleRuns per scan) can write rows
  // without colliding on the old constraint; the new composite
  // @@unique([scanId, module, contractId]) lands below in this PR.
  // Explicit referential actions match the hand-written SQL (no
  // ON DELETE / ON UPDATE clause = Postgres default NO ACTION). Codex
  // Review #1 IMPORTANT 1 — keeps Prisma metadata in sync with the DB
  // so `prisma migrate dev` doesn't spuriously regenerate this FK with
  // its default `SET NULL / CASCADE` referential actions.
  contractId       String
  contract         Contract     @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  module           ModuleName
  status           ModuleStatus @default(QUEUED)
  grade            Grade?
  score            Int?
  findingsCount    Int?
  startedAt        DateTime?
  completedAt      DateTime?
  attemptCount     Int          @default(0)
  errorMessage     String?
  errorStack       String?
  detectorVersions Json
  inputSnapshot    Json
  rpcCallsUsed     Int          @default(0)
  idempotencyKey   String       @unique
  findings         Finding[]

  // Inngest correlation (Plan 02 B.2)
  inngestEventId String?
  inngestRunId   String?

  // Count of detectors that threw during the module run (Plan 02 I.1 FIX 3).
  // Persists the value that runDetectors tracks in-memory as
  // `errorDetectorIds.length`. Drives `Scan.isPartialGrade` at scan
  // finalization: a COMPLETE module with errorDetectorCount > 0 means
  // "a detector that should have run crashed", which degrades the
  // composite-grade confidence. Defaults to 0 so existing rows + FAILED
  // ModuleRuns (where the persist tx doesn't run) read cleanly.
  errorDetectorCount Int @default(0)

  // Plan 03 §3.5 PR 1: legacy @@unique([scanId, module]) DROPPED so the
  // multi-Contract execution model can write N×M rows per scan
  // (one per (Contract, module) pair). PR 2 (this migration) adds the
  // composite unique now that contractId is NOT NULL across all rows —
  // one ModuleRun per (scan, module, contract).
  @@unique([scanId, module, contractId])
}

model Finding {
  id                  String     @id @default(cuid())
  scanId              String
  scan                Scan       @relation(fields: [scanId], references: [id])
  // Plan 03 §3.5 PR 2: tightened to NOT NULL (was nullable in PR 1).
  // Explicit referential actions match the hand-written SQL — see the
  // matching note on `ModuleRun.contract` (Codex Review #1 IMPORTANT 1).
  contractId          String
  contract            Contract   @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  moduleRunId         String
  moduleRun           ModuleRun  @relation(fields: [moduleRunId], references: [id])
  module              ModuleName
  severity            Severity
  publicTitle         String
  title               String
  description         String
  evidence            Json
  affectedComponent   String
  references          Json
  remediationHint     String
  remediationDetailed String
  publicRank          Int
  detectorId          String
  detectorVersion     Int
  createdAt           DateTime   @default(now())

  // Reproducibility (Plan 02 B.2)
  snapshotBlockNumber BigInt?

  @@index([scanId, module])
}

model GovernanceSnapshot {
  id     String  @id @default(cuid())
  // Plan 03 §3.5 PR 1: relaxed to nullable + @unique dropped. PR 2 does NOT
  // re-tighten this column — it stays nullable as a legacy backward-compat
  // column for historical rows (spec §3.5 "Legacy columns kept"). The new
  // unique constraint in PR 2 lands on contractId instead.
  scanId String?
  scan   Scan?   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  // Plan 03 §3.5 PR 2: tightened to NOT NULL + @unique (1:1 with Contract)
  // now that the backfill populated contractId on every row. With @unique
  // in place, the Contract.governanceSnapshot side narrows from an array
  // to `GovernanceSnapshot?` and persistGovernanceSnapshot can return to
  // an atomic contractId-keyed upsert.
  // Explicit referential actions match the hand-written SQL — see the
  // matching note on `ModuleRun.contract` (Codex Review #1 IMPORTANT 1).
  contractId String    @unique
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  blockNumber BigInt
  capturedAt  DateTime @default(now())

  // Governance frameworks detected
  hasGovernor     Boolean       @default(false)
  governorAddress String?
  governorType    GovernorType?
  governorVersion String?

  hasTimelock             Boolean @default(false)
  timelockAddress         String?
  timelockMinDelay        Int?
  timelockAdmin           String?
  timelockAdminIsContract Boolean?

  hasMultisig        Boolean  @default(false)
  multisigAddress    String?
  multisigThreshold  Int?
  multisigOwnerCount Int?
  multisigOwners     String[]

  // Proxy detection (full coverage upfront per Plan 02 self-review:
  // proxyAdminIsContract populated in Phase D.3c, implementationAbi
  // populated in Phase E.2 — declared upfront so no retroactive
  // schema mutations during E phases.)
  proxyType            ProxyType?
  proxyAdminAddress    String?
  proxyImplementation  String?
  proxyVerified        Boolean    @default(false)
  proxyAdminIsContract Boolean?
  implementationAbi    String?
  protocolAbi          String?

  // Voting token (if applicable)
  votingTokenAddress String?
  votingSnapshotType VotingSnapshotType?

  rawState Json

  @@index([scanId])
}

// Plan 03 §3.1: Contract model — one scannable address within a Scan.
// PR 2 (Phase J) shape: contractId is NOT NULL on all child tables and
// GovernanceSnapshot.contractId is @unique, so the relation to
// GovernanceSnapshot is a true 1:1 (`GovernanceSnapshot?`). In the PR 1
// window it was modelled as an array because the @unique did not yet
// exist.
model Contract {
  id              String        @id @default(cuid())
  scanId          String
  // Explicit `onUpdate: NoAction` added (Codex Review #1 IMPORTANT 1) to
  // match the hand-written SQL (`ON DELETE CASCADE` only, no ON UPDATE
  // clause = Postgres default NO ACTION). Without this Prisma's default
  // `Cascade` for ON UPDATE drifts from the DB.
  scan            Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  address         String
  chain           Chain
  role            ContractRole
  label           String?
  crossChainTwins Json          @default("[]")
  isPrimary       Boolean       @default(false)
  createdAt       DateTime      @default(now())

  // Per-Contract composite — computed by markComplete (Plan 03 §4.5) using
  // the Plan 02 spec §5.3 composite algorithm applied to this Contract's
  // findings only. Null until the Contract's ModuleRuns finalise.
  compositeScore  Int?
  compositeGrade  Grade?
  // Per-Contract isPartialGrade — Plan 02 I.1 FIX 3 semantic scoped per
  // Contract. True when at least one of this Contract's COMPLETE ModuleRuns
  // had `errorDetectorCount > 0`.
  isPartialGrade  Boolean       @default(false)

  governanceSnapshot GovernanceSnapshot?
  moduleRuns         ModuleRun[]
  findings           Finding[]

  @@unique([scanId, address])
  @@index([scanId])
}

model Subscription {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  tier           SubscriptionTier @default(FREE)
  status         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
